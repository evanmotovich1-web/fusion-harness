# fusion-harness provider authentication — copy to .env and fill in.
# `set dotenv-load := true` in the justfile exports these for every recipe.

# anthropic/* slots (e.g. claude-fable-5 architect)
ANTHROPIC_API_KEY=

# google/* slots — pi reads GEMINI_API_KEY for the google provider
# (NOT GOOGLE_GENERATIVE_AI_API_KEY).
GEMINI_API_KEY=

# google-vertex/* slots — independent ADC OAuth path; no GEMINI_API_KEY needed.
# Evan runs: gcloud auth application-default login
# Use a project with billing and the Vertex AI API enabled (Vertex is not free).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Optional alternative: service-account credentials, not the user OAuth login above.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# fireworks/* slots (DeepSeek V4 Pro/Flash, Kimi K3, ...)
FIREWORKS_API_KEY=

# openai/* slots (gpt-5.6-sol / terra)
OPENAI_API_KEY=

# openrouter/* slots
OPENROUTER_API_KEY=

# Optional knowledge layer (never put vault secrets here).
# SECOND_BRAIN_VAULT=/Users/evanmotovich/code/second-brain
# FH_KNOWLEDGE=off
# FH_KNOWLEDGE_CAPTURE=on

# /research-x and the x-research workflow (Grok x_search)
XAI_API_KEY=
