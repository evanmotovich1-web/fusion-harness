        {
          "locator": "cases/001/research/043d8a5343b3ace8.txt:86-86",
          "excerpt": "Select Strength (1–4). Default is 3 for a balanced rewrite."
        },
        {
          "locator": "cases/001/research/043d8a5343b3ace8.txt:122-122",
          "excerpt": "You can try the rewriter within a character limit. With a Smodin account you get more characters; paid plans offer up to 1 million characters using credits (1 credit per 1000 characters)."
        },
        {
          "locator": "cases/001/research/043d8a5343b3ace8.txt:108-108",
