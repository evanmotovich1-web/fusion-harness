    {"id":"status-boolean","input":{"action":"update","contacts":[{"id":"a","email":"a@example.invalid"}],"patch":{"id":"a","status":true}},"expected":{"status":"invalid_input","error":"invalid_status"}},
    {"id":"status-number","input":{"action":"update","contacts":[{"id":"a","email":"a@example.invalid"}],"patch":{"id":"a","status":1}},"expected":{"status":"invalid_input","error":"invalid_status"}},
    {"id":"status-unknown","input":{"action":"update","contacts":[{"id":"a","email":"a@example.invalid"}],"patch":{"id":"a","status":"won"}},"expected":{"status":"invalid_input","error":"invalid_status"}},
    {"id":"note-list","input":{"action":"update","contacts":[{"id":"a","email":"a@example.invalid"}],"patch":{"id":"a","note":[]}},"expected":{"status":"invalid_input","error":"invalid_note"}},
    {"id":"note-object","input":{"action":"update","contacts":[{"id":"a","email":"a@example.invalid"}],"patch":{"id":"a","note":{}}},"expected":{"status":"invalid_input","error":"invalid_note"}},
