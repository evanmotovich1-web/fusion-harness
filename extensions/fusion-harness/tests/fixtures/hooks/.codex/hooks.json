{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash herdr-agent-state.sh session", "timeout": 10 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "vault-semantic hook --agent codex --event start", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "vault-semantic hook --agent codex --event prompt", "timeout": 8 }
        ]
      }
    ]
  }
}
