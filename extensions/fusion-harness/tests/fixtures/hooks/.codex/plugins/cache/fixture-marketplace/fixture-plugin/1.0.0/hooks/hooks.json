{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.exit(1)\"",
            "timeout": 900
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"process.exit(0)\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
