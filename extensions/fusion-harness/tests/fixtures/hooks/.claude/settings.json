{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node -e \"process.exit(1)\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node -e \"throw new Error('fixture boom')\"", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node -e \"setTimeout(()=>{}, 60000)\"", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "bash hooks/stop-block.sh", "timeout": 10 }
        ]
      }
    ]
  }
}
